local function loop(myGen)
	local function active() return gen == myGen and enabled end
	while active() do
		local t0 = os.clock()
		while active() and _G.ClientState.Busy and os.clock() - t0 < 60 do task.wait(0.25) end
		if not active() then break end

		local started = false
		for _ = 1, 4 do
			if not active() then break end
			crossLine()
			local t1 = os.clock()
			while os.clock() - t1 < 3 do
				if _G.ClientState.Busy == "Throw" then started = true break end
				task.wait(0.1)
			end
			if started then break end
		end

		if started then
			setStatus(("Throwing... | Done: %d"):format(stats.done))
			local t2 = os.clock()
			while _G.ClientState.Busy == "Throw" and os.clock() - t2 < 60 do task.wait(0.2) end
			stats.done += 1
			setStatus(("Done: %d | Failed: %d"):format(stats.done, stats.failed))
			task.wait(1)
		else
			stats.failed += 1
			setStatus(("Busy | Done: %d | Fail: %d"):format(stats.done, stats.failed))
			task.wait(2)
		end
	end
	setStatus("Status: Idle")
end

