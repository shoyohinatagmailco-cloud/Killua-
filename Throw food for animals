-- 2. AUTO TRAIN LOGIC (Strictly Find & Walk)
-- ==========================================
local function findTrainArea()
    -- Hahanapin ang area na may "train", "gym", o "workout" sa pangalan
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = string.lower(obj.Name)
            if name:find("train") or name:find("gym") or name:find("workout") then
                return obj
            end
        end
    end
    return nil
end

task.spawn(function()
	while true do
		task.wait(1)
		if autoTrainEnabled then
            local char, root, hum = getChar()
            if char and hum then
                local trainArea = findTrainArea()
                if trainArea then
                    local distance = (root.Position - trainArea.Position).Magnitude
                    if distance > 6 then
                        -- Maglakad papunta sa train area
                        hum:MoveTo(trainArea.Position)
                        setStatus("Walking to Train Area...")
                    else
                        -- Pag malapit na, pahintuin
                        hum:MoveTo(root.Position) 
                        setStatus("Arrived at Train Area.")
                    end
                else
                    setStatus("Train Area not found.")
                end
            end
		end
	end
end)

